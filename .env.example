# Salin file ini ke .env lalu isi salah satu API key.

# Gemini (dipakai lebih dulu bila diisi). Buat key gratis di https://aistudio.google.com/apikey
# Boleh beberapa key dipisah koma, masing-masing dari project Google yang berbeda
# (di AI Studio pilih "Create API key in new project"). Dipakai bergiliran, dan
# pindah key otomatis saat kena batas kuota 429.
GEMINI_API_KEY=
# Model Gemini, opsional, boleh beberapa dipisah koma. Default: gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest
GEMINI_MODEL=

# Claude API, opsional. Dipakai hanya bila GEMINI_API_KEY kosong.
ANTHROPIC_API_KEY=

# Paksa provider: gemini atau claude. Opsional.
AI_PROVIDER=

# Port server produksi (npm start). Opsional.
PORT=3000

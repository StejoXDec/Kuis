# Salin file ini ke .env lalu isi salah satu API key.

# Gemini (dipakai lebih dulu bila diisi). Buat key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini, opsional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Claude API, opsional. Dipakai hanya bila GEMINI_API_KEY kosong.
ANTHROPIC_API_KEY=

# Paksa provider: gemini atau claude. Opsional.
AI_PROVIDER=

# Port server produksi (npm start). Opsional.
PORT=3000
